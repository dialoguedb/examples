# Twitch bot credentials — https://dev.twitch.tv/console/apps
TWITCH_BOT_USERNAME=your-bot-username
TWITCH_OAUTH_TOKEN=oauth:your-oauth-token

# Comma-separated list of channels to join
TWITCH_CHANNELS=channel1,channel2

# OpenAI API key — https://platform.openai.com
OPENAI_API_KEY=your-openai-api-key

# DialogueDB credentials — https://dialoguedb.com
DIALOGUEDB_API_KEY=your-dialoguedb-api-key
DIALOGUEDB_ENDPOINT=https://backend.dialoguedb.com
